{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
    <div id="login-container" style="display: {{ app.user ? 'none' : 'block' }};">
        {% if not app.user %}
            {{ render(controller('App\\Controller\\UserController::loginAction')) }}
        {% endif %}
    </div>

    <div id="user-header" style="display: {{ app.user ? 'block' : 'none' }};">
            <h2>Welcome<span id="welcome-user">{% if app.user %} {{ app.user.username }}{% else %} Guest{% endif %}!</span></h2>
            <a href="{{ path('logout') }}">Logout</a>
            <hr>
    </div>

    <div id="post-detail" style="display: none;">
        <h4 id="detail-title"></h4>
        <p id="detail-content"></p>
        <small id="detail-author"></small>
        <br>
        <button id="delete-post" style="display: {{ app.user ? 'inline-block' : 'none' }};">Delete</button>
    </div>

    <div id="post-container" style="display: {{ app.user ? 'block' : 'none' }};">
        <h3>Create Post</h3>
        <div id="post-confirmation" style="color: green; font-weight: bold; margin-bottom: 5px;"></div>

        <form action="{{ path('post_new') }}" id="post-form" method="POST">
            <div>
                <label for="title">Title:</label><br>
                <input type="text" id="title" name="title" required>
            </div>
            <br>
            <div>
                <label for="content">Content:</label><br>
                <textarea id="content" name="content" rows="4" required></textarea>
            </div>
            <br>
            <button type="submit">Publish Post</button>
        </form>
    </div>

    <hr>

    <div>
        <h3>Posts</h3>
        <div id="post-delete-confirmation" style="color: green; font-weight: bold; margin-bottom: 5px;"></div>
        <ul id="posts-list">
            {% for post in posts %}
                <li class="post-item" data-id="{{ post.id }}" style="cursor: pointer;">
                    <strong><a href="{{ path('view_post', { 'id': post.id }) }}">{{ post.title }}</a></strong><br>
                    <small>Created on {{ post.created|date('Y-m-d H:i') }}</small>
                </li>
            {% else %}
                <li id="no-posts">No posts available.</li>
            {% endfor %}
        </ul>
    </div>

    <script>
        const socket = new WebSocket(`ws://${window.location.hostname}:8080`);

        const postForm = document.getElementById('post-form');
        if (postForm) {
            postForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                const title = document.getElementById('title').value;
                const content = document.getElementById('content').value;
                const confirmationDiv = document.getElementById('post-confirmation');
                if (confirmationDiv) {
                    confirmationDiv.textContent = '';
                }

                try {
                    const response = await fetch('{{ path('post_new') }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ title, content })
                    });

                    const data = await response.json();
                    if (response.ok && data.success) {
                        if (confirmationDiv) {
                            confirmationDiv.textContent = data.message;
                        }
                        postForm.reset();

                        const postsList = document.getElementById('posts-list');
                        if (postsList && data.post) {
                            const noPosts = document.getElementById('no-posts');
                            if (noPosts) {
                                noPosts.remove();
                            }
                            const newPost = document.createElement('li');
                            newPost.classList.add('post-item');
                            newPost.dataset.id = data.post.id;
                            newPost.innerHTML = `
                                <strong><a href="/view/${data.post.id}">${data.post.title}</a></strong><br>
                                <small>Created on ${data.post.created}</small>`;
                            postsList.appendChild(newPost);
                            if (socket && socket.readyState === WebSocket.OPEN) {
                                socket.send(JSON.stringify({
                                    action: 'newPost',
                                    post: data.post
                                }));
                            }
                        }
                    } else {
                        alert(data.error || 'Error creating post.');
                    }
                } catch (err) {
                    alert('Error communicating with the server.');
                }
                
            });
        }

        const viewPost = document.getElementById('posts-list');
        if (viewPost) {
            viewPost.addEventListener('click', async function(e){
                e.preventDefault();
                const post = e.target.closest('.post-item');
                if (!post) return;
                const postId = post.dataset.id;
                try {
                    const response = await fetch(`/view/${postId}`);
                    const data = await response.json();
                    if (response.ok && data.success) {
                        document.getElementById('detail-title').textContent = 'Title:' + data.post.title;
                        document.getElementById('detail-content').textContent = data.post.content;
                        document.getElementById('detail-author').textContent = `Author: ${data.post.author}`;
                        document.getElementById('post-detail').style.display = 'block';
                        const deleteButton = document.getElementById('delete-post');
                        if (deleteButton) {
                            deleteButton.dataset.id = data.post.id;
                            const isUserLoggedIn = document.getElementById('user-header').style.display !== 'none';
                            deleteButton.style.display = isUserLoggedIn ? 'inline-block' : 'none';
                        }
                    } else {
                        alert(data.error || 'Error fetching post details.');
                    }
                } catch (err) {
                    alert('Error communicating with the server.');
                }
            });
        }

        const deletePostButton = document.getElementById('delete-post');
        if (deletePostButton) {
            deletePostButton.addEventListener('click', async function(e){
                e.preventDefault();
                if (!confirm('Are you sure you want to delete this post?')) return;
                const postId = this.dataset.id;
                if (!postId) return;
                const confirmationDiv = document.getElementById('post-delete-confirmation');
                if (confirmationDiv) {
                    confirmationDiv.textContent = '';
                }
                const response = await fetch(`/delete/${postId}`, {
                    method: 'DELETE'
                });
                const data = await response.json();
                if (response.ok && data.success) {
                    if (confirmationDiv) {
                        confirmationDiv.textContent = data.message;
                    }
                    const postDetail = document.getElementById('post-detail');
                    if (postDetail) {
                        postDetail.style.display = 'none';
                    }
                    const postItem = document.querySelector(`.post-item[data-id="${postId}"]`);
                    if (postItem) {
                        postItem.remove();
                        if (socket && socket.readyState === WebSocket.OPEN) {
                            socket.send(JSON.stringify({
                                action: 'deletePost',
                                id: postId
                            }));
                        }
                    }

                } else {
                    alert(data.error || 'Error deleting post.');
                }
            });
        }

        socket.addEventListener('open', () => {
            console.log('Connected to the WebSocket on port 8080');
        })

        socket.addEventListener('message', (event) => {
            try {
                const data = JSON.parse(event.data);

                if (data.action === 'newPost' && data.post) {
                    if (!document.querySelector(`.post-item[data-id="${data.post.id}"]`)) {
                        const postsList = document.getElementById('posts-list')
                        if (postsList) {
                            const noPosts = document.getElementById('no-posts');
                            if (noPosts) {
                                noPosts.remove();
                            }
                            const newPost = document.createElement('li');
                            newPost.classList.add('post-item');
                            newPost.dataset.id = data.post.id;
                            newPost.style.cursor = 'pointer';
                            newPost.innerHTML = `
                                <strong><a href="/view/${data.post.id}">${data.post.title}</a></strong><br>
                                <small>Created on ${data.post.created}</small>`;
                            postsList.appendChild(newPost);
                        }
                    }
                }
                if (data.action === 'deletePost' && data.id) {
                    const postItem = document.querySelector(`.post-item[data-id="${data.id}"]`);
                    if (postItem) {
                        postItem.remove();
                    }
                    const deleteBtn = document.getElementById('delete-post');
                    if (deleteBtn && deleteBtn.dataset.id == data.id) {
                        document.getElementById('post-detail').style.display = 'none';
                }
            }
        } catch (err) {
            console.error('Websocket error: ', err);
        }
        });
    </script>
{% endblock %}