<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
    </head>
    <body>
        {% for message in app.flashes('success') %}
            <div style="color: green;">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div style="color: red;">{{ message }}</div>
        {% endfor %}

        {% block body %}{% endblock %}
    </body>
</html>
