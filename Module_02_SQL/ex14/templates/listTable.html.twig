{% extends 'base.html.twig' %}

{% block title %}Generic Table List{% endblock %}

{% block body %}
        <p>
            <a href="{{ path('ex14_addUser') }}">&plus; Insert New User</a>
        </p>
        
        {% for message in app.flashes('success') %}
            <div style="color: green; margin-bottom: 15px;">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div style="color: red; margin-bottom: 15px;">
                {{ message }}
            </div>
        {% endfor %}

        {% if (table_exists is defined and not table_exists) or (tableExists is defined and not tableExists) or (users is null) %}
            <p style="color: red; font-weight: bold;">The table does not exist in the database.</p>
        {% else %}
            <table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse; min-width: 300px; text-align: left;">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users|default([]) %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.username }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" style="text-align: center;">No users found in the table.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}