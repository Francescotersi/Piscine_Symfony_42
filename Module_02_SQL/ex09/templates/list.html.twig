{% extends 'base.html.twig' %}

{% block title %}Ex09 - Data Viewer{% endblock %}

{% block body %}    
    <div style="margin-bottom: 20px;">
        <a href="/person/create" style="margin-right: 10px;">Create Random Person</a>
    </div>

    <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; text-align: left;">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Name</th>
                <th>Email</th>
                <th>Bank Account Balance</th>
                <th>Addresses</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for person in persons %}
                <tr>
                    <td>{{ person.id }}</td>
                    <td>{{ person.username }}</td>
                    <td>{{ person.name }}</td>
                    <td>{{ person.email }}</td>
                    <td>
                        {% if person.bankAccount %}
                            ${{ person.bankAccount.balance }}
                        {% else %}
                            <em>No Bank Account</em>
                        {% endif %}
                    </td>
                    <td>
                        {% if person.addresses|length > 0 %}
                            <ul style="margin: 0; padding-left: 20px;">
                                {% for address in person.addresses %}
                                    <li>{{ address.address }}</li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <em>No Addresses</em>
                        {% endif %}
                    </td>
                    <td>
                        <a href="/person/{{ person.id }}/add-bank-account">Add Bank Account</a><br>
                        <a href="/person/{{ person.id }}/add-address">Add Address</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">No persons found in the database.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
