{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
    <div style="padding: 20px;">
        {% if app.user %}
            <h1>Welcome back, {{ app.user.userIdentifier }}[{{ app.user.getReputation() }}]!</h1>
            <p>You are currently logged in.</p>
            <p>
                <a href="{{ path('e03_post_new') }}"><button type="button">+ Create New Post</button></a>
                <a href="{{ path('e01_logout') }}"><button type="button">Logout</button></a>
            </p>
            {% if is_granted('ROLE_ADMIN') %}
                <p><a href="{{ path('e02_admin') }}">Go to Admin Panel</a></p>
            {% endif %}
        {% else %}
            <h1>Welcome, {{ app.session.get('anonimous_name') }}!</h1>
            {% set seconds = app.session.get('seconds_since_last_request') %}
            {% if seconds is not null %}
                <p>Time since last request: <strong>{{ seconds }}</strong> second{{ seconds == 1 ? '' : 's' }}.</p>
            {% else %}
                <p>This is your first request!</p>
            {% endif %}
            <p>Log in or sign up to interact:</p>
            <p>
                <a href="{{ path('e01_login') }}">Login</a> | 
                <a href="{{ path('e01_register') }}">Sign Up</a>
            </p>
        {% endif %}

        <hr style="margin: 25px 0;">

        <h2>Latest Posts</h2>
        {% if posts is empty %}
            <p>No posts created yet.</p>
        {% else %}
            <ul style="line-height: 1.8;">
                {% for post in posts %}
                    <li>
                        <a href="{{ path('e03_post_show', {'id': post.id}) }}">
                            <strong>{{ post.title }}</strong>
                        </a>
                        — by <em>{{ post.author.username }}[{{ post.author.getReputation() }}]</em> on {{ post.created|date('d/m/Y H:i') }}
                        <br>
                        likes :({{ post.likesCount }})
                        dislikes :({{ post.dislikesCount }})
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}