{%extends 'base.html.twig' %}

{% block title %}Exercise 2{% endblock %}

{% block content %}
    <h1>Exercise 2: Write to File</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        {{ form_widget(form) }}
    {{ form_end(form) }}

    {% if last_line %}
        <div style="margin-top: 20px; padding: 15px; border: 1px solid #4CAF50; background-color: #f1f8e9;">
            <h3>Success! The last line added to the file was:</h3>
            <p><strong>{{ last_line }}</strong></p>
        </div>
    {% endif %}
{% endblock %}