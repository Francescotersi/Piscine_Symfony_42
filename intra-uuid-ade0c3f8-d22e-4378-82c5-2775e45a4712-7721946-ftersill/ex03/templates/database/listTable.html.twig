
{% block title %} ORM Doctrine {% endblock %}

{% extends 'base.html.twig' %}

{% block body %}

    <h1>Project Database Content</h1>
    
    <table border="1" cellpadding="10">
        <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Enable</th>
                    <th>Birthdate</th>
                    <th>Adress</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.username }}</td>
                    <td>{{ user.name }}</td>
                    <td>{{ user.email }}</td>
                    {% if user.enable %}
                        <td>yes</td>
                    {% else %}
                        <td>no</td>
                    {% endif %}
                    <td>{{ user.birthdate }}</td>
                    <td>{{ user.address }}</td>
                </tr>
            {% else %}
            <tr>
                <td colspan="3">No records found in the database.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    
    <br>
    <a href="{{ path('ex03_updateTable') }}">Add New Data</a>

{% endblock %}
